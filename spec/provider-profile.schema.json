{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lansi Codex Provider Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "enabled", "authMode"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "enabled": {"type": "boolean"},
    "authMode": {"type": "string", "enum": ["chatgpt_login", "api_key"]},
    "baseUrl": {"type": "string", "format": "uri"},
    "wireApi": {"type": "string", "enum": ["responses", "chat_completions", "custom"]},
    "apiKeyEnv": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
    "model": {"type": "string", "minLength": 1},
    "reasoningEffort": {"type": "string"},
    "reviewModel": {"type": "string"},
    "configOverrides": {"type": "object", "additionalProperties": false}
  },
  "allOf": [
    {"if": {"properties": {"authMode": {"const": "api_key"}}}, "then": {"required": ["baseUrl", "apiKeyEnv"]}}
  ]
}
